{
  "name": "@wdk/wdk-secret-manager",
  "version": "1.0.0",
  "description": "Works with mnemonic and seed buffer",
  "main": "index.js",
  "type": "module",
  "types": "./types",
  "scripts": {
    "build:types": "rimraf *.d.ts **/*.d.ts; tsc",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test:bare": "bare tests/wdk-secret-manager.bare.test.js"
  },
  "homepage": "https://github.com/tetherto/wdk-secret-manager.git",
  "dependencies": {
    "bare-wdk-runtime": "2.0.0",
    "b4a": "1.6.7",
    "bip39-mnemonic": "2.5.0",
    "sodium-native": "5.0.6"
  },
  "devDependencies": {
    "brittle": "3.3.0",
    "rimraf": "6.0.1",
    "standard": "17.1.2",
    "typescript": "5.8.3"
  },
  "exports": {
    ".": {
      "types": "./types/wdk-secret-manager.d.ts",
      "bare": "./bare.js",
      "default": "./index.js"
    },
    "./package": {
      "default": "./package.json"
    }
  },
  "standard": {
    "ignore": [
      "bare.js",
      "tests/**/*.js"
    ]
  }
}